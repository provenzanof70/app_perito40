{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scheda_bene.v1.schema.json",
  "title": "Scheda del bene — v1",
  "description": "Un file per bene nella cartella beni/ della pratica (es. beni/B01.json). Censimento, classificazione proposta, dati agli atti compilati sul PC con il loro esito di verifica in campo, gruppi di evidenze attesi.",
  "type": "object",
  "required": ["formato", "versioneSchema", "demo", "codicePratica", "codice", "denominazione", "funzione", "componenti", "classificazione", "datiAgliAtti", "gruppiEvidenze"],
  "additionalProperties": false,
  "properties": {
    "formato": { "const": "perizia40.scheda_bene" },
    "versioneSchema": { "$ref": "comuni.v1.schema.json#/$defs/versioneSchema" },
    "demo": { "type": "boolean", "description": "true per dati fittizi; nel repository pubblico è obbligatorio" },
    "codicePratica": { "$ref": "comuni.v1.schema.json#/$defs/codicePratica" },
    "codice": {
      "type": "string", "pattern": "^B[0-9]{2}$",
      "description": "Codice stabile del bene principale; i componenti sono in componenti[]"
    },
    "denominazione": { "$ref": "comuni.v1.schema.json#/$defs/testo", "description": "Nome riconoscibile in campo" },
    "funzione": { "$ref": "comuni.v1.schema.json#/$defs/testo", "description": "Funzione produttiva effettiva, sintetica" },
    "ubicazione": { "type": "string" },
    "componenti": {
      "type": "array",
      "description": "Componenti o sottomacchine B01.1, B01.2… Il raggruppamento organizza le evidenze ma non decide perimetro né classificazione (§2.7).",
      "items": {
        "type": "object",
        "required": ["codice", "denominazione", "tipo"],
        "additionalProperties": false,
        "properties": {
          "codice": { "type": "string", "pattern": "^B[0-9]{2}\\.[0-9]{1,2}$" },
          "denominazione": { "$ref": "comuni.v1.schema.json#/$defs/testo" },
          "tipo": { "enum": ["M", "QM", "ITS", "ACC"], "description": "Macchina, quasi-macchina, insieme, accessorio" },
          "costruttore": { "type": "string" },
          "funzione": { "type": "string" }
        }
      }
    },
    "classificazione": {
      "type": "object",
      "description": "Gate di classificazione proposto (§2.3). Il gruppo determina il profilo dei requisiti; l'interconnessione resta sempre necessaria.",
      "required": ["regime", "allegato", "voce", "profilo", "sostenibilita", "motivazione", "fonti"],
      "additionalProperties": false,
      "properties": {
        "regime": { "const": "CRI_4.0", "description": "Credito d'imposta beni strumentali 4.0 (Allegati A e B). Altri regimi in versioni successive." },
        "allegato": { "enum": ["A", "B"] },
        "gruppo": { "enum": [1, 2, 3], "description": "Solo per Allegato A" },
        "voce": { "$ref": "comuni.v1.schema.json#/$defs/testo" },
        "profilo": { "enum": ["completo", "ridotto"], "description": "completo = A Gruppo 1 (5 RO + almeno 2 RU); ridotto = A Gruppi 2-3 e Allegato B" },
        "ruDichiarati": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["RU1", "RU2", "RU3"] },
          "description": "Requisiti ulteriori dichiarati per il profilo completo"
        },
        "sostenibilita": { "enum": ["solida", "da_motivare", "debole"] },
        "motivazione": { "$ref": "comuni.v1.schema.json#/$defs/testo" },
        "fonti": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/refEv" } }
      },
      "if": { "properties": { "allegato": { "const": "A" } } },
      "then": { "required": ["gruppo"] },
      "else": { "not": { "required": ["gruppo"] } }
    },
    "datiAgliAtti": {
      "type": "object",
      "description": "Dati ricavati dai documenti, compilati sul PC. L'andata li porta sul telefono come valori da verificare; il rientro ne riporta l'esito, che il PC registra in verificaCampo.",
      "required": ["identita", "controllore", "hmi", "reteDichiarata", "dichiarazioneCE", "esitoGateC"],
      "additionalProperties": false,
      "properties": {
        "identita": {
          "type": "object", "required": ["costruttore", "modello", "matricola", "anno"], "additionalProperties": false,
          "properties": {
            "costruttore": { "$ref": "#/$defs/voceAgliAtti" },
            "modello": { "$ref": "#/$defs/voceAgliAtti" },
            "matricola": { "$ref": "#/$defs/voceAgliAtti" },
            "anno": { "$ref": "#/$defs/voceAgliAtti" }
          }
        },
        "controllore": {
          "type": "object", "required": ["marca", "modello", "firmware"], "additionalProperties": false,
          "description": "PLC/CNC",
          "properties": {
            "marca": { "$ref": "#/$defs/voceAgliAtti" },
            "modello": { "$ref": "#/$defs/voceAgliAtti" },
            "firmware": { "$ref": "#/$defs/voceAgliAtti" }
          }
        },
        "hmi": {
          "type": "object", "required": ["modello"], "additionalProperties": false,
          "properties": { "modello": { "$ref": "#/$defs/voceAgliAtti" } }
        },
        "reteDichiarata": {
          "type": "object", "required": ["ip", "sistemaAziendale", "protocollo"], "additionalProperties": false,
          "properties": {
            "ip": { "$ref": "#/$defs/voceAgliAtti" },
            "sistemaAziendale": { "$ref": "#/$defs/voceAgliAtti" },
            "protocollo": { "$ref": "#/$defs/voceAgliAtti" }
          }
        },
        "dichiarazioneCE": {
          "type": "object", "required": ["numero", "data", "direttive", "riferimentoMatricola"], "additionalProperties": false,
          "properties": {
            "numero": { "$ref": "#/$defs/voceAgliAtti" },
            "data": { "$ref": "#/$defs/voceAgliAtti" },
            "direttive": { "$ref": "#/$defs/voceAgliAtti", "description": "Direttive o regolamento citati" },
            "riferimentoMatricola": { "$ref": "#/$defs/voceAgliAtti", "description": "Se la DdC cita la matricola dell'esemplare o solo la famiglia" }
          }
        },
        "esitoGateC": {
          "type": "object",
          "required": ["esito", "motivazione", "fonti", "stato"],
          "additionalProperties": false,
          "properties": {
            "esito": { "enum": ["verde", "giallo", "rosso"] },
            "motivazione": { "$ref": "comuni.v1.schema.json#/$defs/testo" },
            "fonti": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/refEv" } },
            "stato": { "$ref": "comuni.v1.schema.json#/$defs/statoDato" },
            "verificaCampo": { "$ref": "#/$defs/verificaCampo" }
          }
        }
      }
    },
    "gruppiEvidenze": {
      "type": "array",
      "description": "Gruppi 1-10 e DOC con l'attesa derivata dal profilo (§2.7). Il conteggio indica presenza di materiale, non sufficienza.",
      "minItems": 11, "maxItems": 11,
      "items": {
        "type": "object",
        "required": ["gruppo", "titolo", "requisiti", "attesa"],
        "additionalProperties": false,
        "properties": {
          "gruppo": { "$ref": "comuni.v1.schema.json#/$defs/gruppoEvidenza" },
          "titolo": { "$ref": "comuni.v1.schema.json#/$defs/testo" },
          "requisiti": { "type": "array", "minItems": 1, "items": { "$ref": "comuni.v1.schema.json#/$defs/requisito" } },
          "attesa": { "$ref": "comuni.v1.schema.json#/$defs/attesa" },
          "motivoVariazione": { "type": "string", "description": "Obbligatorio se l'attesa differisce da quella standard del profilo" },
          "evidenzeRaccolte": { "type": "integer", "minimum": 0 },
          "nota": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "voceAgliAtti": {
      "type": "object",
      "description": "Valore + fonte [ev:] + stato. Documentato richiede almeno una fonte. nonApplicabile per voci che il bene non ha (es. nessun HMI).",
      "required": ["valore", "fonti", "stato"],
      "additionalProperties": false,
      "properties": {
        "valore": { "type": ["string", "null"] },
        "fonti": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/refEv" } },
        "stato": { "$ref": "comuni.v1.schema.json#/$defs/statoDato" },
        "nonApplicabile": { "type": "boolean" },
        "nota": { "type": "string" },
        "verificaCampo": { "$ref": "#/$defs/verificaCampo" }
      }
    },
    "verificaCampo": {
      "type": "object",
      "description": "Esito in campo riportato dal rientro e registrato sul PC",
      "required": ["esito", "idRientro", "data"],
      "additionalProperties": false,
      "properties": {
        "esito": { "enum": ["confermato", "corretto", "difforme", "non_verificabile"] },
        "valoreRilevato": { "type": "string" },
        "evidenze": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/idEvidenza" } },
        "idRientro": { "$ref": "comuni.v1.schema.json#/$defs/uuid" },
        "data": { "$ref": "comuni.v1.schema.json#/$defs/dataGiorno" },
        "nota": { "type": "string" }
      }
    }
  }
}
