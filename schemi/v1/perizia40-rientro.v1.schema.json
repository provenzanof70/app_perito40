{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "perizia40-rientro.v1.schema.json",
  "title": "Pacchetto di rientro Perizia 4.0 — v1",
  "description": "File perizia40-rientro.json alla radice di ogni volume del pacchetto esportato dall'app. Ogni volume ripete lo stato completo (evidenze, verifiche, registri) e contiene solo i file indicati nel manifesto con il proprio numero di volume. Accanto c'è hash.sha256 con le impronte di tutti i file del volume.",
  "type": "object",
  "required": ["formato", "versioneSchema", "demo", "idRientro", "tipoPacchetto", "volume", "andata", "codicePratica", "app", "creatoIl", "fusoOrario", "sopralluogo", "evidenze", "verificheDati", "riscontriDiretti", "dichiarazioniTerzi", "dateRilevate", "nuoveAzioni", "aggiornamentiAzioni", "manifesto"],
  "additionalProperties": false,
  "properties": {
    "formato": { "const": "perizia40.rientro" },
    "versioneSchema": { "$ref": "comuni.v1.schema.json#/$defs/versioneSchema" },
    "demo": { "type": "boolean" },
    "idRientro": { "$ref": "comuni.v1.schema.json#/$defs/uuid", "description": "Uguale in tutti i volumi dello stesso pacchetto" },
    "tipoPacchetto": {
      "enum": ["checkpoint", "finale"],
      "description": "checkpoint = esportazione intermedia (file nuovi dall'ultimo checkpoint, stato completo); finale = completo e chiuso"
    },
    "numeroCheckpoint": { "type": "integer", "minimum": 1, "description": "Progressivo, solo per i checkpoint" },
    "volume": {
      "type": "object", "required": ["numero", "totale"], "additionalProperties": false,
      "properties": {
        "numero": { "type": "integer", "minimum": 1 },
        "totale": { "type": "integer", "minimum": 1 }
      }
    },
    "andata": {
      "type": "object", "required": ["idAndata", "revisione", "sha256"], "additionalProperties": false,
      "description": "Pacchetto di andata da cui nasce il sopralluogo",
      "properties": {
        "idAndata": { "$ref": "comuni.v1.schema.json#/$defs/uuid" },
        "revisione": { "type": "string", "pattern": "^rev[0-9]{3}$" },
        "sha256": { "$ref": "comuni.v1.schema.json#/$defs/sha256", "description": "Impronta di perizia40-andata.json così come caricato" }
      }
    },
    "codicePratica": { "$ref": "comuni.v1.schema.json#/$defs/codicePratica" },
    "app": {
      "type": "object", "required": ["versione"], "additionalProperties": false,
      "properties": {
        "versione": { "type": "string" },
        "piattaforma": { "type": "string" },
        "installata": { "type": "boolean", "description": "true se avviata dall'icona sulla Home" }
      }
    },
    "creatoIl": { "$ref": "comuni.v1.schema.json#/$defs/dataOra" },
    "fusoOrario": { "type": "string", "description": "Es. Europe/Rome" },
    "sopralluogo": {
      "type": "object", "required": ["id", "data", "presenti"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "comuni.v1.schema.json#/$defs/idSopralluogo" },
        "data": { "$ref": "comuni.v1.schema.json#/$defs/dataGiorno", "description": "Data della visita" },
        "inizio": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "fine": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "presenti": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/persona" } }
      }
    },
    "evidenze": {
      "type": "array",
      "description": "Tutte le evidenze acquisite nel sopralluogo, comprese quelle annullate (mai cancellate)",
      "items": { "$ref": "comuni.v1.schema.json#/$defs/evidenza" }
    },
    "verificheDati": {
      "type": "array",
      "description": "Esito in campo di ciascun dato agli atti portato dall'andata",
      "items": {
        "type": "object",
        "required": ["bene", "campo", "valoreAgliAtti", "esito", "evidenze", "data"],
        "additionalProperties": false,
        "properties": {
          "bene": { "type": "string", "pattern": "^B[0-9]{2}$" },
          "campo": { "$ref": "comuni.v1.schema.json#/$defs/campoAgliAtti" },
          "valoreAgliAtti": { "type": ["string", "null"] },
          "esito": {
            "enum": ["confermato", "corretto", "difforme", "non_verificabile"],
            "description": "corretto = il dato agli atti era incompleto o errato e si registra il valore rilevato; difforme = il bene in campo non corrisponde ai documenti (alert)"
          },
          "valoreRilevato": { "type": "string" },
          "evidenze": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/idEvidenza" } },
          "data": { "$ref": "comuni.v1.schema.json#/$defs/dataGiorno" },
          "nota": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "esito": { "enum": ["corretto", "difforme"] } } },
            "then": { "required": ["valoreRilevato"] }
          },
          {
            "if": { "properties": { "esito": { "enum": ["confermato", "corretto", "difforme"] } } },
            "then": { "properties": { "evidenze": { "minItems": 1 } } },
            "else": { "required": ["nota"] }
          }
        ]
      }
    },
    "riscontriDiretti": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/riscontroDiretto" } },
    "dichiarazioniTerzi": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/dichiarazioneTerzi" } },
    "dateRilevate": {
      "type": "array",
      "description": "Date lette in campo (targhe, verbali, schermate). Il PC le rinumera all'importazione nella timeline.",
      "items": { "$ref": "comuni.v1.schema.json#/$defs/rigaTimeline" }
    },
    "nuoveAzioni": {
      "type": "array",
      "description": "Lacune emerse in campo, già trasformate in azioni",
      "items": { "$ref": "comuni.v1.schema.json#/$defs/azione" }
    },
    "aggiornamentiAzioni": {
      "type": "array",
      "description": "Esito in campo delle azioni aperte. L'app propone; la chiusura la decide il perito sul PC.",
      "items": {
        "type": "object", "required": ["idAzione", "esitoCampo"], "additionalProperties": false,
        "properties": {
          "idAzione": { "$ref": "comuni.v1.schema.json#/$defs/idAzione" },
          "esitoCampo": { "enum": ["proposta_chiusura", "parziale", "non_risolta"] },
          "motivoProposto": { "enum": ["evidenza_acquisita", "riscontro_diretto"] },
          "evidenze": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/idEvidenza" } },
          "riscontro": { "$ref": "comuni.v1.schema.json#/$defs/idRiscontro" },
          "nota": { "type": "string" }
        },
        "if": { "properties": { "esitoCampo": { "const": "proposta_chiusura" } } },
        "then": { "required": ["motivoProposto"] }
      }
    },
    "manifesto": {
      "type": "array",
      "description": "Manifesto SHA-256 di tutte le evidenze del pacchetto (§10.10), con il volume che contiene ciascun file",
      "items": { "$ref": "comuni.v1.schema.json#/$defs/rigaManifesto" }
    }
  },
  "if": { "properties": { "tipoPacchetto": { "const": "checkpoint" } } },
  "then": { "required": ["numeroCheckpoint"] }
}
