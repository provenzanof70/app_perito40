{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pratica_40.v1.schema.json",
  "title": "Pratica Perizia 4.0 — v1",
  "description": "File pratica_40.json alla radice della cartella della pratica sul PC. Contiene il fascicolo istruttorio: beni, sopralluoghi, evidenze, timeline, azioni, registri dei riscontri e delle dichiarazioni, manifesto di integrità, pacchetti scambiati con l'app.",
  "type": "object",
  "required": ["formato", "versioneSchema", "demo", "codicePratica", "regime", "annualita", "cliente", "perito", "persone", "beni", "sopralluoghi", "evidenze", "timeline", "azioni", "riscontriDiretti", "dichiarazioniTerzi", "manifesto", "pacchetti"],
  "additionalProperties": false,
  "properties": {
    "formato": { "const": "perizia40.pratica" },
    "versioneSchema": { "$ref": "comuni.v1.schema.json#/$defs/versioneSchema" },
    "demo": { "type": "boolean" },
    "codicePratica": { "$ref": "comuni.v1.schema.json#/$defs/codicePratica" },
    "regime": { "const": "CRI_4.0" },
    "annualita": { "type": "integer", "minimum": 2017, "maximum": 2100 },
    "aggiornataIl": { "$ref": "comuni.v1.schema.json#/$defs/dataOra" },
    "cliente": {
      "type": "object", "required": ["ragioneSociale", "sedeIntervento"], "additionalProperties": false,
      "properties": {
        "ragioneSociale": { "$ref": "comuni.v1.schema.json#/$defs/testo" },
        "sedeIntervento": { "$ref": "comuni.v1.schema.json#/$defs/testo" },
        "partitaIva": { "type": "string", "pattern": "^[0-9]{11}$", "description": "(v1.4)" },
        "sedeLegale": { "$ref": "comuni.v1.schema.json#/$defs/testo", "description": "(v1.4)" },
        "logo": { "type": "string", "description": "Logo dell'impresa per le copertine, percorso relativo alla cartella della pratica (v1.4)" },
        "legaleRappresentante": {
          "type": "object", "required": ["nome"], "additionalProperties": false,
          "description": "Firmatario di NDA e DSAN. I dati personali restano nella cartella privata della pratica, mai nel repository (v1.4)",
          "properties": {
            "nome": { "$ref": "comuni.v1.schema.json#/$defs/testo" },
            "carica": { "type": "string" },
            "luogoNascita": { "type": "string" },
            "dataNascita": { "$ref": "comuni.v1.schema.json#/$defs/dataGiorno" },
            "codiceFiscale": { "type": "string", "pattern": "^[A-Z0-9]{16}$" }
          }
        },
        "rspp": {
          "type": "object", "required": ["nome"], "additionalProperties": false, "description": "Presa visione della DSAN 2 (v1.4)",
          "properties": { "nome": { "$ref": "comuni.v1.schema.json#/$defs/testo" } }
        }
      }
    },
    "perito": {
      "type": "object", "required": ["nome"], "additionalProperties": false,
      "properties": { "nome": { "$ref": "comuni.v1.schema.json#/$defs/testo" }, "albo": { "type": "string" } }
    },
    "persone": {
      "type": "array", "description": "Referenti e terzi citati nella pratica",
      "items": { "$ref": "comuni.v1.schema.json#/$defs/persona" }
    },
    "beni": {
      "type": "array", "description": "Vuoto solo nella pratica appena creata, prima dell'analisi dei documenti (v1.4)",
      "items": {
        "type": "object", "required": ["codice", "denominazione", "scheda"], "additionalProperties": false,
        "properties": {
          "codice": { "type": "string", "pattern": "^B[0-9]{2}$" },
          "denominazione": { "$ref": "comuni.v1.schema.json#/$defs/testo" },
          "scheda": { "type": "string", "pattern": "^beni/B[0-9]{2}\\.json$" }
        }
      }
    },
    "sopralluoghi": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "data", "stato"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "comuni.v1.schema.json#/$defs/idSopralluogo" },
          "data": { "$ref": "comuni.v1.schema.json#/$defs/dataGiorno" },
          "stato": { "enum": ["previsto", "eseguito", "annullato"] },
          "presenti": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/idPersona" } },
          "nota": { "type": "string" }
        }
      }
    },
    "beniNuovi": {
      "type": "array",
      "description": "Beni censiti in campo in attesa di decisione del perito su perimetro e classificazione (v1.1)",
      "items": { "$ref": "comuni.v1.schema.json#/$defs/beneNuovo" }
    },
    "evidenze": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/evidenza" } },
    "timeline": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/rigaTimeline" } },
    "azioni": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/azione" } },
    "riscontriDiretti": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/riscontroDiretto" } },
    "dichiarazioniTerzi": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/dichiarazioneTerzi" } },
    "noteCampo": {
      "type": "array",
      "description": "Note di campo importate: promemoria, non base probatoria (v1.1)",
      "items": { "$ref": "comuni.v1.schema.json#/$defs/notaCampo" }
    },
    "manifesto": { "type": "array", "items": { "$ref": "comuni.v1.schema.json#/$defs/rigaManifesto" } },
    "pacchetti": {
      "type": "array",
      "description": "Pacchetti di andata generati e di rientro importati, con la loro impronta",
      "items": {
        "type": "object", "required": ["tipo", "id", "file", "sha256", "data"], "additionalProperties": false,
        "properties": {
          "tipo": { "enum": ["andata", "rientro_checkpoint", "rientro_finale"] },
          "id": { "$ref": "comuni.v1.schema.json#/$defs/uuid" },
          "volume": { "type": "integer", "minimum": 1 },
          "file": { "$ref": "comuni.v1.schema.json#/$defs/testo" },
          "sha256": { "$ref": "comuni.v1.schema.json#/$defs/sha256" },
          "data": { "$ref": "comuni.v1.schema.json#/$defs/dataOra" }
        }
      }
    }
  }
}
